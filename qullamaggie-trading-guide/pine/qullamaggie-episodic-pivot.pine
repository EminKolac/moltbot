//@version=6
// =====================================================================================
// Qullamaggie — EPISODIC PIVOT / EP (backtestable strategy)
// Educational only. NOT financial advice.
//
// Catalyst gap that begins a new trend: gap >= 10%, volume explosion, stock NOT already
// extended (so the news is a real surprise), opening above the base and the 50-day.
// Same risk/exit engine as the breakout: LOD stop <= 1x ADR, risk sizing, partial, MA trail.
//
// HONEST LIMITATIONS:
//   1) Pine has NO earnings/guidance feed, so it cannot judge catalyst QUALITY
//      (triple-digit growth, big beat). This approximates an EP by gap% + volume only.
//   2) Opening-range entries are intraday; on a DAILY chart this enters on the gap day's
//      close holding above the open. For true 1m/5m ORH, run on an intraday chart.
// =====================================================================================
strategy("Qulla Episodic Pivot", overlay=true, initial_capital=100000,
     default_qty_type=strategy.fixed, calc_on_every_tick=false, process_orders_on_close=true,
     commission_type=strategy.commission.percent, commission_value=0.02, slippage=2, pyramiding=0)

// ----------------------------- Inputs -----------------------------
gEP        = "Episodic Pivot filters"
minGapPct  = input.float(10.0, "Min gap up %",                   group=gEP)
volMult    = input.float(2.0,  "Min volume x avg(20)",           group=gEP)
notExtLook = input.int(120,    "Not-extended lookback (bars)",   minval=20, group=gEP)
maxPriorPct= input.float(30.0, "Max prior run % (avoid extended)", group=gEP)
adrLen     = input.int(20,     "ADR length",                     minval=2, group=gEP)
adrMinPct  = input.float(5.0,  "Min ADR %",                      group=gEP)
dollarVolM = input.float(20.0, "Min $ volume (millions)",        group=gEP)
holdGap    = input.bool(true,  "Require close to hold the gap (close>=open)", group=gEP)

gReg       = "Regime (optional for EPs)"
useRegime  = input.bool(false,       "Require risk-on regime",   group=gReg)
regimeSym  = input.symbol("AMEX:SPY","Regime index",            group=gReg)

gRisk      = "Risk & exits"
riskPct    = input.float(0.5,  "Risk per trade %",               minval=0.01, group=gRisk)
adrStopMul = input.float(1.0,  "Max stop = x ADR",               minval=0.1,  group=gRisk)
minDays    = input.int(3,      "Min days before partial",        minval=0,    group=gRisk)
maxDays    = input.int(5,      "Days -> take partial anyway",    minval=1,    group=gRisk)
partialR   = input.float(2.5,  "Partial at R multiple",          group=gRisk)
partialPct = input.int(40,     "Partial size %",                 minval=1, maxval=99, group=gRisk)
trailLen   = input.int(20,     "Trail MA length (EPs ride 20/50)", minval=2,  group=gRisk)
trailType  = input.string("EMA","Trail MA type", options=["EMA","SMA"],       group=gRisk)

// ----------------------------- Indicators -----------------------------
adrPct    = (ta.sma(high / low, adrLen) - 1.0) * 100.0
adrDollar = close * adrPct / 100.0
dollarVol = close * volume
gapPct    = (open - close[1]) / close[1] * 100.0
volOK     = volume >= ta.sma(volume, 20) * volMult
priorRun  = (close[1] / close[notExtLook] - 1.0) * 100.0     // run BEFORE the gap
sma50     = ta.sma(close, 50)
trailMA   = trailType == "EMA" ? ta.ema(close, trailLen) : ta.sma(close, trailLen)

regFast   = request.security(regimeSym, "D", ta.sma(close, 10))
regSlow   = request.security(regimeSym, "D", ta.sma(close, 20))
regimeOK  = not useRegime or (regFast > regSlow and regFast > regFast[1])

// ----------------------------- Entry logic -----------------------------
isEP      = gapPct >= minGapPct and volOK and priorRun <= maxPriorPct and close > sma50 and (not holdGap or close >= open)
qualifies = adrPct >= adrMinPct and dollarVol >= dollarVolM * 1e6

entryPrice = close
rawStop    = low
stopDist   = entryPrice - rawStop
validStop  = stopDist > 0 and stopDist <= adrDollar * adrStopMul
goLong     = regimeOK and isEP and qualifies and validStop and strategy.position_size == 0
qty        = validStop ? math.floor((strategy.equity * riskPct / 100.0) / stopDist) : 0

var float entryRef = na
var float stopRef  = na
var int   entryBar = na
var bool  partialed = false

if goLong and qty > 0
    strategy.entry("Long", strategy.long, qty=qty)
    entryRef  := entryPrice
    stopRef   := rawStop
    entryBar  := bar_index
    partialed := false

// ----------------------------- Management -----------------------------
inLong   = strategy.position_size > 0
daysHeld = inLong ? bar_index - entryBar : 0
curR     = inLong and (entryRef - stopRef) > 0 ? (close - entryRef) / (entryRef - stopRef) : 0.0

if inLong and not partialed and daysHeld >= minDays and (curR >= partialR or daysHeld >= maxDays)
    strategy.close("Long", qty_percent=partialPct, comment="partial")
    stopRef   := math.max(stopRef, entryRef)
    partialed := true

if inLong
    strategy.exit("stop", "Long", stop=stopRef)

if inLong and partialed and close < trailMA
    strategy.close("Long", comment="MA trail")

// ----------------------------- Plots -----------------------------
plot(sma50,   "50 MA", color=color.new(color.gray, 0))
plot(trailMA, "Trail MA", color=color.new(color.blue, 0))
plot(inLong ? stopRef : na, "Stop", color=color.red, style=plot.style_linebr, linewidth=2)
bgcolor(isEP ? color.new(color.teal, 85) : na, title="EP day")
plotshape(goLong and qty > 0, "EP entry", shape.triangleup, location.belowbar, color.new(color.green,0), size=size.small)
