# Copy to .env and fill in. .env is gitignored.

# One or more Apify API tokens, comma-separated (rotation pool).
# Get a token at https://console.apify.com/account/integrations
APIFY_TOKENS=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Primary discovery + analysis actor (pay-per-use, no login).
APIFY_DISCOVERY_ACTOR=apivault_labs~shopify-store-analyzer
# Optional secondary actor with an explicit ships-to-country discovery filter.
APIFY_SHIPSTO_ACTOR=clearpath~shopify-store-leads

PORT=8787
DATABASE_PATH=./data/shopfinder.db
